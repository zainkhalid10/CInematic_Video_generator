# === LLM APIs (spec §10.1) ===
# Online (recommended): Claude — strong JSON / structured output for Phase 1 & 5
ANTHROPIC_API_KEY=
# Optional override if your Anthropic console uses a different snapshot:
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Offline fallback: Ollama — free, local; pull one of: llama3.2:3b, mistral:7b, qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

OPENAI_API_KEY=

# === TTS (spec §6) ===
# coqui = multi-speaker VITS (offline, spec default) | bark = Suno Bark (offline, expressive) | edge-tts = Microsoft neural (online, no GPU)
TTS_ENGINE=coqui
COQUI_MODEL=tts_models/en/vctk/vits

# === Image Generation (spec §7.1) ===
# pollinations = free online Flux (no key) | automatic1111 = local SD 1.5+ (best offline quality with GPU)
IMAGE_ENGINE=pollinations
POLLINATIONS_MODEL=flux
AUTOMATIC1111_URL=http://localhost:7860
VISUAL_PROMPT_PREFIX=cinematic, highly detailed, 4k,

# === Video export ===
VIDEO_FPS=24
VIDEO_CRF=20

# === Music (spec §6.4) ===
BGM_ENGINE=library

# === App ===
OUTPUT_DIR=./outputs
DB_PATH=./outputs/state.db
PORT=8000

# --- Free model quick reference (see README "Free models") ---
# LLM online: Anthropic Claude (console free tier), Google AI Studio (Gemini), OpenRouter (credits)
# LLM offline: Ollama models — llama3.2:3b, mistral:7b, phi3, qwen2.5
# TTS offline: Coqui VITS, Bark | TTS online: edge-tts (this repo), Piper
# Image online: Pollinations | Image offline: A1111 / ComfyUI with SD 1.5 or SDXL
# BGM offline: assets/bgm CC0 library | MusicGen-small (GPU) via BGM_ENGINE=musicgen
