# === LLM — Ollama (free, local) ===
# Start: ollama serve   then: ollama pull llama3.2:3b
# Stronger models (need more RAM): mistral:7b, qwen2.5:7b, phi3:medium
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Raise if long scripts truncate; lower on very small RAM machines
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_CTX=8192

# === TTS (spec §6) ===
# Python 3.12+: edge-tts default. Python 3.11-: can set coqui
TTS_ENGINE=edge-tts
COQUI_MODEL=tts_models/en/vctk/vits

# === Image Generation ===
IMAGE_ENGINE=pollinations
POLLINATIONS_MODEL=flux
AUTOMATIC1111_URL=http://localhost:7860
VISUAL_PROMPT_PREFIX=cinematic, highly detailed, 4k,

# === Video export ===
VIDEO_FPS=24
VIDEO_CRF=20

# === Music ===
BGM_ENGINE=library

# === App ===
OUTPUT_DIR=./outputs
DB_PATH=./outputs/state.db
PORT=8000

# Free stack: Ollama (LLM) + edge-tts or Coqui (TTS) + Pollinations (images) + assets/bgm
